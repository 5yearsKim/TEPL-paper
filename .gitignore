*.bcf
/main.log
/main.out
/supplement.log
/supplement.out
/indent.log

# Local Python environments and caches.
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Rebuilt evaluation executables and generated compiler dumps.
# Keep measurements, logs, source snapshots, inputs and provenance in Git.
/evaluation/*/bin/
/evaluation/xla-rewrite-count-models/*/hlo/final.hlo

# Temporary files, editor backups and operating-system metadata.
tmp/
/main.bak*
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Local credentials; keep example configuration files available to commit.
.env
.env.*
!.env.example
!.env.template
