# Built documents. Figure PDFs are source assets and must remain versioned.
/main.pdf
/supplement.pdf

# LaTeX auxiliary files (including builds of other document entry points).
*.aux
*.bbl
*.blg
*.cut
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.lof
*.lot
*.loa
*.nav
*.snm
*.vrb
*.xdv
