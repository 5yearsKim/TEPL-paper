from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot,transpose};
rule chain_automatic_10 {
    A1: f32[B, D0, D1]
    A2: f32[B, D1, D2]
    A3: f32[B, D2, D3]
    A4: f32[B, D3, D4]
    A5: f32[B, D4, D5]
    A6: f32[B, D5, D6]
    A7: f32[B, D6, D7]
    A8: f32[B, D7, D8]
    A9: f32[B, D8, D9]
    A10: f32[B, D9, D10]
    A11: f32[B, D10, D11]

    (l10: dot (l9: dot (l8: dot (l7: dot (l6: dot (l5: dot (l4: dot (l3: dot (l2: dot (l1: dot A1 A2) A3) A4) A5) A6) A7) A8) A9) A10) A11)
    =>
    (dot A1 (dot A2 (dot A3 (dot A4 (dot A5 (dot A6 (dot A7 (dot A8 (dot A9 (dot A10 A11))))))))))
    where {
        B > 0
        && D0 > 0
        && D1 > 0
        && D2 > 0
        && D3 > 0
        && D4 > 0
        && D5 > 0
        && D6 > 0
        && D7 > 0
        && D8 > 0
        && D9 > 0
        && D10 > 0
        && D11 > 0
        && l1.attrs.lhs_contracting_dimensions == [2]
        && l1.attrs.rhs_contracting_dimensions == [1]
        && l1.attrs.lhs_batching_dimensions == [0]
        && l1.attrs.rhs_batching_dimensions == [0]
        && l2.attrs.lhs_contracting_dimensions == [2]
        && l2.attrs.rhs_contracting_dimensions == [1]
        && l2.attrs.lhs_batching_dimensions == [0]
        && l2.attrs.rhs_batching_dimensions == [0]
        && l3.attrs.lhs_contracting_dimensions == [2]
        && l3.attrs.rhs_contracting_dimensions == [1]
        && l3.attrs.lhs_batching_dimensions == [0]
        && l3.attrs.rhs_batching_dimensions == [0]
        && l4.attrs.lhs_contracting_dimensions == [2]
        && l4.attrs.rhs_contracting_dimensions == [1]
        && l4.attrs.lhs_batching_dimensions == [0]
        && l4.attrs.rhs_batching_dimensions == [0]
        && l5.attrs.lhs_contracting_dimensions == [2]
        && l5.attrs.rhs_contracting_dimensions == [1]
        && l5.attrs.lhs_batching_dimensions == [0]
        && l5.attrs.rhs_batching_dimensions == [0]
        && l6.attrs.lhs_contracting_dimensions == [2]
        && l6.attrs.rhs_contracting_dimensions == [1]
        && l6.attrs.lhs_batching_dimensions == [0]
        && l6.attrs.rhs_batching_dimensions == [0]
        && l7.attrs.lhs_contracting_dimensions == [2]
        && l7.attrs.rhs_contracting_dimensions == [1]
        && l7.attrs.lhs_batching_dimensions == [0]
        && l7.attrs.rhs_batching_dimensions == [0]
        && l8.attrs.lhs_contracting_dimensions == [2]
        && l8.attrs.rhs_contracting_dimensions == [1]
        && l8.attrs.lhs_batching_dimensions == [0]
        && l8.attrs.rhs_batching_dimensions == [0]
        && l9.attrs.lhs_contracting_dimensions == [2]
        && l9.attrs.rhs_contracting_dimensions == [1]
        && l9.attrs.lhs_batching_dimensions == [0]
        && l9.attrs.rhs_batching_dimensions == [0]
        && l10.attrs.lhs_contracting_dimensions == [2]
        && l10.attrs.rhs_contracting_dimensions == [1]
        && l10.attrs.lhs_batching_dimensions == [0]
        && l10.attrs.rhs_batching_dimensions == [0]
    }
}
