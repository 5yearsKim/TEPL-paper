from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot,transpose};
rule rank_8_explicit { A:f32[D0,D1,D2,D3,D4,D5,D6,D7]
 (p3: transpose (p2: transpose (p1: transpose A))) => (out: transpose A)
 derive {out.attrs={permutation:gather(gather(p1.attrs.permutation, p2.attrs.permutation), p3.attrs.permutation)};}
}
