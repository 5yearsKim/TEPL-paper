from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot,transpose};
rule chain_explicit_6 {
    A1: f32[B, D0, D1]
    A2: f32[B, D1, D2]
    A3: f32[B, D2, D3]
    A4: f32[B, D3, D4]
    A5: f32[B, D4, D5]
    A6: f32[B, D5, D6]
    A7: f32[B, D6, D7]

    (l6: dot (l5: dot (l4: dot (l3: dot (l2: dot (l1: dot A1 A2) A3) A4) A5) A6) A7)
    =>
    (r1: dot A1 (r2: dot A2 (r3: dot A3 (r4: dot A4 (r5: dot A5 (r6: dot A6 A7))))))
    where {
        B > 0
        && D0 > 0
        && D1 > 0
        && D2 > 0
        && D3 > 0
        && D4 > 0
        && D5 > 0
        && D6 > 0
        && D7 > 0
        && l1.attrs.lhs_contracting_dimensions == [2]
        && l1.attrs.rhs_contracting_dimensions == [1]
        && l1.attrs.lhs_batching_dimensions == [0]
        && l1.attrs.rhs_batching_dimensions == [0]
        && l2.attrs.lhs_contracting_dimensions == [2]
        && l2.attrs.rhs_contracting_dimensions == [1]
        && l2.attrs.lhs_batching_dimensions == [0]
        && l2.attrs.rhs_batching_dimensions == [0]
        && l3.attrs.lhs_contracting_dimensions == [2]
        && l3.attrs.rhs_contracting_dimensions == [1]
        && l3.attrs.lhs_batching_dimensions == [0]
        && l3.attrs.rhs_batching_dimensions == [0]
        && l4.attrs.lhs_contracting_dimensions == [2]
        && l4.attrs.rhs_contracting_dimensions == [1]
        && l4.attrs.lhs_batching_dimensions == [0]
        && l4.attrs.rhs_batching_dimensions == [0]
        && l5.attrs.lhs_contracting_dimensions == [2]
        && l5.attrs.rhs_contracting_dimensions == [1]
        && l5.attrs.lhs_batching_dimensions == [0]
        && l5.attrs.rhs_batching_dimensions == [0]
        && l6.attrs.lhs_contracting_dimensions == [2]
        && l6.attrs.rhs_contracting_dimensions == [1]
        && l6.attrs.lhs_batching_dimensions == [0]
        && l6.attrs.rhs_batching_dimensions == [0]
    }
    derive {
        r6.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        r5.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        r4.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        r3.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        r2.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        r1.attrs = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
    }
}
